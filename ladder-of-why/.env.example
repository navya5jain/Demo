# Copy to .env and fill in ONE provider. With no .env at all the game still
# runs, using the offline template engine.

# --- Claude (recommended) -------------------------------------------------
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Optional. Ladders default to claude-sonnet-5, grading to claude-haiku-4-5-20251001.
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Any OpenAI-compatible endpoint (OpenAI, Groq, OpenRouter, Ollama) ----
# LLM_PROVIDER=openai_compatible
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- No key, no network ---------------------------------------------------
# LLM_PROVIDER=mock

# Where the SQLite file lives.
# LADDER_DB=./ladder.db
